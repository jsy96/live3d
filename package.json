{
  "name": "ai-live3d",
  "version": "1.0.0",
  "description": "AI 3D desktop pet (VRM + Electron), designed to roam between desktop and phone",
  "main": "main/main.js",
  "scripts": {
    "build": "esbuild src/app.js --bundle --format=iife --outfile=dist/bundle.js --log-level=warning",
    "start": "npm run build && electron .",
    "start:fast": "electron ."
  },
  "devDependencies": {
    "@cloudbase/cli": "^3.9.5",
    "electron": "^33.0.0",
    "esbuild": "^0.24.0"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "^3.11.2",
    "@pixiv/three-vrm": "^3.0.0",
    "@pixiv/three-vrm-animation": "^3.6.0",
    "qrcode": "^1.5.4",
    "three": "^0.170.0",
    "ws": "^8.23.1"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
